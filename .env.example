# ==============================================================================
# CAURI SANDBOX API — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# PostgreSQL Configuration
POSTGRES_USER=cauri_user
POSTGRES_PASSWORD=cauri_password_secret
POSTGRES_DB=cauri_db
POSTGRES_PORT=5434

# Prisma Database Connection URLs
# For local machine access:
DATABASE_URL="postgresql://cauri_user:cauri_password_secret@localhost:5434/cauri_db?schema=public"
# For Docker internal access (inside container):
# DATABASE_URL="postgresql://cauri_user:cauri_password_secret@postgres:5432/cauri_db?schema=public"

# MongoDB Configuration
MONGO_DB=cauri_audit
MONGO_PORT=27018
MONGO_URI="mongodb://localhost:27018/cauri_audit"
# For Docker internal access (inside container):
# MONGO_URI="mongodb://mongo:27017/cauri_audit"

# Security & Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=60
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_TOLERANCE_SECONDS=300

# Demo Merchant Credentials
DEMO_MERCHANT_ID="mch_0182ab91-ca91-42ab-8901-cauri0000001"
DEMO_API_KEY="sk_test_demo123"
DEMO_WEBHOOK_SECRET="whsec_cauri_secret_demo456"
